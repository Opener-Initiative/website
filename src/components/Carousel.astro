---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { ChevronLeft, ChevronRight } from "lucide-react";

interface Props {
  /** Photos in 3:2. Other ratios are cropped to fit. */
  images: { src: ImageMetadata; alt: string; caption?: string }[];
  /** Name for screen readers. Must be unique on the page. */
  label?: string;
}

const { images, label = "Photos" } = Astro.props;
const multiple = images.length > 1;
---

<section
  class="carousel"
  aria-roledescription="carousel"
  aria-label={label}
  data-carousel={multiple}
>
  <div class="track">
    {images.map(({ src, alt, caption }) => (
      <figure>
        <Image src={src} alt={alt} />
        {caption && <figcaption>{caption}</figcaption>}
      </figure>
    ))}
  </div>
  {multiple && (
    <>
      <button type="button" class="prev" aria-label="Previous photo" disabled>
        <ChevronLeft aria-hidden="true" />
      </button>
      <button type="button" class="next" aria-label="Next photo">
        <ChevronRight aria-hidden="true" />
      </button>
    </>
  )}
</section>

<style>
  .carousel {
    position: relative;
    margin: 2em 0;
    container-type: inline-size;
  }
  .track {
    display: flex;
    margin-inline: -1px;
    clip-path: inset(0 1px);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .track figure {
    flex: 0 0 100%;
    margin: 0;
    scroll-snap-align: start;
  }
  .track img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }
  button {
    position: absolute;
    top: calc(100cqw / 3);
    translate: 0 -50%;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid hsl(var(--border));
    border-radius: 9999px;
    background: hsl(var(--background) / 0.8);
    color: hsl(var(--foreground));
    transition:
      color 0.15s,
      opacity 0.15s;
  }
  button :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
  }
  button:hover:not(:disabled) {
    color: hsl(var(--primary));
  }
  button:disabled {
    opacity: 0.4;
  }
  button:focus-visible {
    outline: 2px solid hsl(var(--ring));
    outline-offset: 2px;
  }
  .prev {
    left: 0.5rem;
  }
  .next {
    right: 0.5rem;
  }
  @media (min-width: 64rem) {
    .prev {
      left: auto;
      right: calc(100% + 1rem);
    }
    .next {
      right: auto;
      left: calc(100% + 1rem);
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .track {
      scroll-behavior: smooth;
    }
  }
</style>

<script>
  for (const carousel of document.querySelectorAll("[data-carousel]")) {
    const track = carousel.querySelector<HTMLElement>(".track")!;
    const [prev, next] = carousel.querySelectorAll("button");

    const update = () => {
      const index = Math.round(track.scrollLeft / track.clientWidth);
      const focused = document.activeElement;
      prev.disabled = index === 0;
      next.disabled = index === track.children.length - 1;
      // A disabled button loses focus. Hand it to the other one.
      if (focused === prev && prev.disabled) next.focus();
      if (focused === next && next.disabled) prev.focus();
    };

    prev.addEventListener("click", () =>
      track.scrollBy({ left: -track.clientWidth }),
    );
    next.addEventListener("click", () =>
      track.scrollBy({ left: track.clientWidth }),
    );
    track.addEventListener("scroll", update);
    update();
  }
</script>
