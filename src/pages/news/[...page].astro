---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import Base from "@/layouts/Base.astro";
import NewsCard from "@/components/NewsCard.astro";
import { getPublishedNews } from "@/lib/news";

export const getStaticPaths = (async ({ paginate }) => {
  const entries = await getPublishedNews();
  return paginate(entries, { pageSize: 12 });
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { page } = Astro.props;
---

<Base
  title="Newsroom"
  description="News and updates from the Opener Initiative."
  class="min-h-screen flex flex-col"
>
  <main class="flex-1 container px-4 py-32">
    <div class="max-w-5xl mx-auto">
      <h1 class="text-4xl font-bold tracking-tight mb-8">Newsroom</h1>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {page.data.map((entry) => <NewsCard entry={entry} />)}
      </div>
      {
        (page.url.prev || page.url.next) && (
          <nav aria-label="Pagination" class="mt-12 flex items-center justify-between text-sm">
            {page.url.prev ? (
              <a href={page.url.prev} class="hover:underline">
                &larr; Newer posts
              </a>
            ) : (
              <span />
            )}
            <span class="text-muted-foreground">
              Page {page.currentPage} of {page.lastPage}
            </span>
            {page.url.next ? (
              <a href={page.url.next} class="hover:underline">
                Older posts &rarr;
              </a>
            ) : (
              <span />
            )}
          </nav>
        )
      }
    </div>
  </main>
</Base>
