---
import { Image } from "astro:assets";
import Base from "@/layouts/Base.astro";
import notFoundImage from "@/assets/404-not-found.png";
---

<Base title="Page not found">
  <main class="container h-svh px-4 pt-16 flex items-center justify-center">
    <Image
      src={notFoundImage}
      alt="Page not found"
      class="w-full max-w-4xl max-h-full object-contain"
      loading="eager"
    />
  </main>
</Base>
