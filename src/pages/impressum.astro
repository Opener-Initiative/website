---
import Base from "@/layouts/Base.astro";
---

<Base title="Impressum" class="min-h-screen flex flex-col">
  <main class="flex-1 container px-4 py-32">
    <div class="max-w-3xl mx-auto">
      <h1 class="text-4xl font-bold tracking-tight mb-8">Impressum</h1>

      <section class="mb-10">
        <h2 class="text-2xl font-semibold mb-4">
          Information pursuant to § 5 DDG
        </h2>
        <address class="not-italic text-muted-foreground leading-relaxed">
          Prof. Dr.-Ing. María Dolores Pérez Guirao<br />
          c/o Ostfalia Hochschule für angewandte Wissenschaften<br />
          – Hochschule Braunschweig/Wolfenbüttel<br />
          Salzdahlumer Str. 46/48<br />
          38302 Wolfenbüttel<br />
          Germany
        </address>
      </section>

      <section class="mb-10">
        <h2 class="text-2xl font-semibold mb-4">Contact</h2>
        <p class="text-muted-foreground leading-relaxed">
          Phone: +49 5331 939 42690<br />
          Email:{" "}
          <a
            href="mailto:m.perez@ostfalia.de"
            class="underline hover:text-foreground"
          >
            m.perez@ostfalia.de
          </a>
        </p>
      </section>

      <section class="mb-10">
        <h2 class="text-2xl font-semibold mb-4">
          Responsible for content pursuant to § 18&nbsp;(2) MStV
        </h2>
        <address class="not-italic text-muted-foreground leading-relaxed">
          Prof. Dr.-Ing. María Dolores Pérez Guirao<br />
          c/o Ostfalia Hochschule für angewandte Wissenschaften<br />
          – Hochschule Braunschweig/Wolfenbüttel<br />
          Salzdahlumer Str. 46/48<br />
          38302 Wolfenbüttel<br />
          Germany
        </address>
      </section>
    </div>
  </main>
</Base>
