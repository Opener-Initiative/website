# Redirect www to the apex domain.
# TODO: Promote to 301 once properly tested.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.opener-initiative\.org$ [NC]
  RewriteRule ^ https://opener-initiative.org%{REQUEST_URI} [R=302,L]
</IfModule>

# Serve Astro's generated 404 page instead of Apache's default.
ErrorDocument 404 /404.html

# Compress text responses. Brotli is listed first so it wins when both are available;
# the filters never both apply, as each declines when a Content-Encoding is already present.
<IfModule mod_filter.c>
  <IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/javascript application/javascript text/plain application/xml text/xml image/svg+xml
  </IfModule>
  <IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript text/plain application/xml text/xml image/svg+xml
  </IfModule>
</IfModule>
